---
import { formatDate } from "@utils/format";

interface Props {
  title: string;
  date: Date;
  place: string;
  description: string;
  cover: string;
  status: "upcoming" | "past";
}

const { title, date, place, description, cover, status } = Astro.props;
---

<article class="grid overflow-hidden border border-cherry-900/10 bg-white shadow-soft md:grid-cols-[0.9fr_1.1fr]">
  <div class="aspect-[4/3] overflow-hidden bg-cherry-900 md:aspect-auto">
    <img src={cover} alt={title} width="900" height="675" loading="lazy" class="h-full w-full object-cover" />
  </div>
  <div class="flex flex-col p-6">
    <div class="flex flex-wrap items-center gap-3">
      <time datetime={date.toISOString()} class="text-sm font-bold text-gold-700">{formatDate(date)}</time>
      <span class:list={[
        "rounded-full px-3 py-1 text-[0.7rem] font-bold uppercase tracking-[0.16em]",
        status === "upcoming" ? "bg-cherry-700 text-white" : "bg-smoke text-ink/60"
      ]}>
        {status === "upcoming" ? "Ближайшее" : "Прошедшее"}
      </span>
    </div>
    <h3 class="mt-4 font-display text-3xl leading-tight text-cherry-900">{title}</h3>
    <p class="mt-2 text-sm font-semibold text-ink/70">{place}</p>
    <p class="mt-4 text-sm leading-7 text-ink/60">{description}</p>
  </div>
</article>
