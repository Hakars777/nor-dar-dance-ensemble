---
interface Props {
  title: string;
  description: string;
  image: string;
  href?: string;
}

const { title, description, image, href = "/contacts/" } = Astro.props;
---

<article class="group overflow-hidden border border-cherry-900/10 bg-silk shadow-soft transition duration-300 hover:-translate-y-1 hover:shadow-premium">
  <a href={href} class="focus-ring block">
    <div class="aspect-[4/3] overflow-hidden bg-cherry-900">
      <img src={image} alt={title} width="900" height="675" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
    </div>
    <div class="p-6">
      <h3 class="font-display text-2xl leading-tight text-cherry-900">{title}</h3>
      <p class="mt-3 text-sm leading-7 text-ink/70">{description}</p>
      <span class="mt-5 inline-flex items-center border-b border-gold-500 pb-1 text-sm font-bold text-cherry-800">
        Подробнее
      </span>
    </div>
  </a>
</article>
