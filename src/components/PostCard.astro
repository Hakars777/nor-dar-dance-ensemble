---
import { formatDate } from "@utils/format";

interface Props {
  title: string;
  date: Date;
  cover: string;
  excerpt: string;
  href: string;
}

const { title, date, cover, excerpt, href } = Astro.props;
---

<article class="group overflow-hidden border border-cherry-900/10 bg-white shadow-soft transition duration-300 hover:-translate-y-1 hover:shadow-premium">
  <a href={href} class="focus-ring block">
    <div class="aspect-[16/10] overflow-hidden bg-cherry-900">
      <img src={cover} alt={title} width="960" height="600" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
    </div>
    <div class="p-6">
      <time datetime={date.toISOString()} class="text-xs font-bold uppercase tracking-[0.2em] text-gold-700">{formatDate(date)}</time>
      <h3 class="mt-3 font-display text-2xl leading-tight text-cherry-900">{title}</h3>
      <p class="mt-3 text-sm leading-7 text-ink/60">{excerpt}</p>
      <span class="mt-5 inline-flex border-b border-gold-500 pb-1 text-sm font-bold text-cherry-800">Читать</span>
    </div>
  </a>
</article>
