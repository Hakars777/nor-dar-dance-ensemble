---
import { getEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import SectionTitle from "@components/SectionTitle.astro";

const settingsEntry = await getEntry("settings", "site");
const settings = settingsEntry?.data;
const socialLinks = [
  { label: "Instagram", href: settings?.instagram },
  { label: "Facebook", href: settings?.facebook },
  { label: "YouTube", href: settings?.youtube },
  { label: "Telegram", href: settings?.telegram }
].filter((item) => item.href);
---

<BaseLayout title="Контакты" description="Контакты Nor-Dar Dance Ensemble: телефон, email, социальные сети, адрес и форма заявки на выступление.">
  <PageHero
    eyebrow="Контакты"
    title="Связаться с ансамблем"
    description="Напишите нам о мероприятии, дате, площадке и желаемом формате выступления."
  />

  <section class="py-16 md:py-24">
    <div class="container-page grid gap-10 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <SectionTitle
          eyebrow="Заявка"
          title="Пригласите Nor-Dar на сцену"
          description="Мы ответим, уточним детали события и предложим подходящий формат программы."
        />
        <div class="mt-8 grid gap-4 text-sm">
          <a href={`tel:${settings?.phone}`} class="border border-cherry-900/10 bg-white p-5 font-bold text-cherry-900 shadow-soft transition hover:border-gold-500">{settings?.phone}</a>
          <a href={`mailto:${settings?.email}`} class="border border-cherry-900/10 bg-white p-5 font-bold text-cherry-900 shadow-soft transition hover:border-gold-500">{settings?.email}</a>
          <p class="border border-cherry-900/10 bg-white p-5 font-semibold text-ink/70 shadow-soft">{settings?.address}</p>
        </div>
        <div class="mt-5 flex flex-wrap gap-2">
          {
            socialLinks.map((item) => (
              <a href={item.href} target="_blank" rel="noreferrer" class="focus-ring rounded-sm border border-cherry-900/20 px-4 py-2 text-sm font-bold text-cherry-900 transition hover:border-gold-500 hover:text-gold-700">
                {item.label}
              </a>
            ))
          }
        </div>
      </div>

      <form class="grid gap-5 border border-cherry-900/10 bg-white p-6 shadow-soft md:p-8" data-contact-form>
        <div class="grid gap-5 md:grid-cols-2">
          <label class="grid gap-2 text-sm font-bold text-cherry-900">
            Имя
            <input name="name" required autocomplete="name" class="min-h-12 border border-cherry-900/20 bg-ivory px-4 text-ink outline-none transition focus:border-gold-500" />
          </label>
          <label class="grid gap-2 text-sm font-bold text-cherry-900">
            Телефон
            <input name="phone" required autocomplete="tel" class="min-h-12 border border-cherry-900/20 bg-ivory px-4 text-ink outline-none transition focus:border-gold-500" />
          </label>
        </div>
        <label class="grid gap-2 text-sm font-bold text-cherry-900">
          Email
          <input name="email" type="email" autocomplete="email" class="min-h-12 border border-cherry-900/20 bg-ivory px-4 text-ink outline-none transition focus:border-gold-500" />
        </label>
        <div class="grid gap-5 md:grid-cols-2">
          <label class="grid gap-2 text-sm font-bold text-cherry-900">
            Дата мероприятия
            <input name="eventDate" type="date" class="min-h-12 border border-cherry-900/20 bg-ivory px-4 text-ink outline-none transition focus:border-gold-500" />
          </label>
          <label class="grid gap-2 text-sm font-bold text-cherry-900">
            Город / площадка
            <input name="place" class="min-h-12 border border-cherry-900/20 bg-ivory px-4 text-ink outline-none transition focus:border-gold-500" />
          </label>
        </div>
        <label class="grid gap-2 text-sm font-bold text-cherry-900">
          Сообщение
          <textarea name="message" required rows="6" class="resize-y border border-cherry-900/20 bg-ivory px-4 py-3 text-ink outline-none transition focus:border-gold-500"></textarea>
        </label>
        <button type="submit" class="focus-ring inline-flex min-h-12 items-center justify-center rounded-sm bg-cherry-800 px-6 py-3 text-sm font-bold text-white transition hover:bg-cherry-700">
          Отправить заявку
        </button>
        <p class="min-h-6 text-sm font-semibold text-gold-700" data-contact-status aria-live="polite"></p>
      </form>
    </div>
  </section>

  <script>
    const form = document.querySelector("[data-contact-form]");
    const status = document.querySelector("[data-contact-status]");

    function getContactPayload(formElement) {
      const formData = new FormData(formElement);
      return {
        name: String(formData.get("name") || ""),
        phone: String(formData.get("phone") || ""),
        email: String(formData.get("email") || ""),
        eventDate: String(formData.get("eventDate") || ""),
        place: String(formData.get("place") || ""),
        message: String(formData.get("message") || "")
      };
    }

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const payload = getContactPayload(form);
      window.dispatchEvent(new CustomEvent("nor-dar-contact-request", { detail: payload }));
      console.info("Contact request payload is ready for Telegram or email API integration:", payload);
      if (status) {
        status.textContent = "Спасибо. Заявка подготовлена, мы свяжемся с вами по указанным контактам.";
      }
      form.reset();
    });
  </script>
</BaseLayout>
