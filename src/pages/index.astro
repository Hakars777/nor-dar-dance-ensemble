---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import SectionTitle from "@components/SectionTitle.astro";
import EventCard from "@components/EventCard.astro";
import PostCard from "@components/PostCard.astro";
import ProgramCard from "@components/ProgramCard.astro";
import GalleryGrid from "@components/GalleryGrid.astro";
import { sortByDateAsc, sortByDateDesc } from "@utils/format";

const settingsEntry = await getEntry("settings", "site");
const settings = settingsEntry?.data;

const [events, news, gallery, programs] = await Promise.all([
  getCollection("events"),
  getCollection("news", ({ data }) => !data.draft),
  getCollection("gallery"),
  getCollection("programs")
]);

const upcomingEvents = sortByDateAsc(events.filter((event) => event.data.status === "upcoming")).slice(0, 2);
const latestNews = sortByDateDesc(news).slice(0, 3);
const featuredGallery = gallery.filter((item) => item.data.featured).length > 0 ? gallery.filter((item) => item.data.featured) : gallery;
const orderedPrograms = [...programs].sort((a, b) => a.data.order - b.data.order).slice(0, 6);
---

<BaseLayout description={settings?.seoDescription}>
  <Hero
    title="Nor-Dar Dance Ensemble"
    subtitle="Армянский танцевальный ансамбль, соединяющий традицию, сценическую энергию и современную эстетику."
    heroImage={settings?.heroImage}
  />

  <section class="py-16 md:py-24">
    <div class="container-page grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
      <div>
        <SectionTitle
          eyebrow="О ансамбле"
          title="Танец как культурная память и живая сцена"
          description="Nor-Dar Dance Ensemble представляет армянскую танцевальную культуру в элегантной сценической форме: от традиционных номеров до ярких шоу-программ для концертов, фестивалей, свадеб и камерных событий."
        />
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/about/" class="focus-ring inline-flex min-h-12 items-center justify-center rounded-sm bg-cherry-800 px-6 py-3 text-sm font-bold text-white transition hover:bg-cherry-700">Узнать больше</a>
          <a href="/gallery/" class="focus-ring inline-flex min-h-12 items-center justify-center rounded-sm border border-cherry-900/20 px-6 py-3 text-sm font-bold text-cherry-900 transition hover:border-gold-500 hover:text-gold-700">Смотреть галерею</a>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        <div class="border border-cherry-900/10 bg-white p-6 shadow-soft">
          <p class="font-display text-5xl leading-none text-cherry-800">6</p>
          <p class="mt-3 text-sm font-semibold text-ink/70">форматов выступлений</p>
        </div>
        <div class="border border-cherry-900/10 bg-white p-6 shadow-soft">
          <p class="font-display text-5xl leading-none text-cherry-800">360°</p>
          <p class="mt-3 text-sm font-semibold text-ink/70">подход к событию</p>
        </div>
        <div class="border border-cherry-900/10 bg-white p-6 shadow-soft">
          <p class="font-display text-5xl leading-none text-cherry-800">Live</p>
          <p class="mt-3 text-sm font-semibold text-ink/70">энергия армянской сцены</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 md:py-24">
    <div class="container-page">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <SectionTitle
          eyebrow="Направления"
          title="Наши программы"
          description="Готовые и индивидуальные постановки для разных сцен, форматов и настроений события."
        />
        <a href="/programs/" class="focus-ring inline-flex min-h-11 items-center justify-center rounded-sm border border-cherry-900/20 px-5 py-3 text-sm font-bold text-cherry-900 transition hover:border-gold-500 hover:text-gold-700">Все программы</a>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          orderedPrograms.map((program) => (
            <ProgramCard title={program.data.title} description={program.data.description} image={program.data.image} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container-page">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <SectionTitle
          eyebrow="Афиша"
          title="Ближайшие мероприятия"
          description="Концерты, фестивали и события, где можно увидеть Nor-Dar Dance Ensemble на сцене."
        />
        <a href="/events/" class="focus-ring inline-flex min-h-11 items-center justify-center rounded-sm border border-cherry-900/20 px-5 py-3 text-sm font-bold text-cherry-900 transition hover:border-gold-500 hover:text-gold-700">Вся афиша</a>
      </div>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {
          upcomingEvents.map((event) => (
            <EventCard
              title={event.data.title}
              date={event.data.date}
              place={event.data.place}
              description={event.data.description}
              cover={event.data.cover}
              status={event.data.status}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-cherry-900 py-16 text-white md:py-24">
    <div class="container-page">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.28em] text-gold-100/80">Новости</p>
          <h2 class="ornament-line font-display text-4xl leading-[1.02] text-white md:text-5xl">Последние новости</h2>
        </div>
        <a href="/news/" class="focus-ring inline-flex min-h-11 items-center justify-center rounded-sm border border-gold-300/50 px-5 py-3 text-sm font-bold text-gold-100 transition hover:bg-gold-300 hover:text-cherry-900">Все новости</a>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          latestNews.map((post) => (
            <PostCard
              title={post.data.title}
              date={post.data.date}
              cover={post.data.cover}
              excerpt={post.data.excerpt}
              href={`/news/${post.slug}/`}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container-page">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <SectionTitle
          eyebrow="Галерея"
          title="Сцена, костюмы, движение"
          description="Визуальный образ ансамбля: теплый свет сцены, армянская пластика и премиальная подача каждого номера."
        />
        <a href="/gallery/" class="focus-ring inline-flex min-h-11 items-center justify-center rounded-sm border border-cherry-900/20 px-5 py-3 text-sm font-bold text-cherry-900 transition hover:border-gold-500 hover:text-gold-700">Открыть галерею</a>
      </div>
      <div class="mt-10">
        <GalleryGrid items={featuredGallery} limit={6} />
      </div>
    </div>
  </section>

  <section class="bg-white py-16 md:py-24">
    <div class="container-page grid gap-10 lg:grid-cols-[1fr_.85fr] lg:items-center">
      <SectionTitle
        eyebrow="Контакты"
        title="Пригласить ансамбль на событие"
        description="Расскажите о формате мероприятия, сцене и желаемой атмосфере. Мы предложим программу, которая будет выглядеть цельно, уважительно к традиции и эффектно для зрителей."
      />
      <div class="border border-cherry-900/10 bg-ivory p-7 shadow-soft">
        <p class="font-display text-3xl leading-tight text-cherry-900">{settings?.phone}</p>
        <a href={`mailto:${settings?.email}`} class="mt-3 block text-sm font-bold text-gold-700">{settings?.email}</a>
        <p class="mt-4 text-sm leading-7 text-ink/70">{settings?.address}</p>
        <a href="/contacts/" class="focus-ring mt-6 inline-flex min-h-12 items-center justify-center rounded-sm bg-cherry-800 px-6 py-3 text-sm font-bold text-white transition hover:bg-cherry-700">Связаться</a>
      </div>
    </div>
  </section>
</BaseLayout>
