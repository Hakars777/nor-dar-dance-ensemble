---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="Страница не найдена" description="Запрошенная страница Nor-Dar Dance Ensemble не найдена.">
  <section class="container-page grid min-h-[60vh] place-items-center py-24 text-center">
    <div>
      <p class="font-display text-8xl leading-none text-cherry-800">404</p>
      <h1 class="mt-4 font-display text-5xl leading-tight text-cherry-900">Страница не найдена</h1>
      <p class="mt-4 text-ink/70">Возможно, ссылка изменилась или материал был перенесен.</p>
      <a href="/" class="focus-ring mt-8 inline-flex min-h-12 items-center justify-center rounded-sm bg-cherry-800 px-6 py-3 text-sm font-bold text-white transition hover:bg-cherry-700">На главную</a>
    </div>
  </section>
</BaseLayout>
